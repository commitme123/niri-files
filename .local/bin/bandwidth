#!/bin/bash
CACHE="$HOME/.cache/bandwidth-stat"

IFACE=$(ip route show default 2>/dev/null | awk '{print $5}' | head -1)
[ -z "$IFACE" ] && { echo '{"text":"  ?"}'; exit 0; }

read_rx_tx() {
    awk -v iface="$IFACE" '$1 ~ iface":" {rx=$2; tx=$10} END {print rx, tx}' /proc/net/dev
}

read -r rx tx <<< "$(read_rx_tx)"
[ -z "$rx" ] && { echo '{"text":"  ?"}'; exit 0; }

now=$(date +%s)
if [ -f "$CACHE" ]; then
    read -r old_rx old_tx old_ts < "$CACHE"
    elapsed=$((now - old_ts))
    if [ "$elapsed" -gt 0 ] && [ "$elapsed" -lt 10 ]; then
        rx_rate=$(( (rx - old_rx) / elapsed ))
        tx_rate=$(( (tx - old_tx) / elapsed ))
    else
        rx_rate=0; tx_rate=0
    fi
else
    rx_rate=0; tx_rate=0
fi

echo "$rx $tx $now" > "$CACHE"

fmt() {
    local val=$1
    [ "$val" -lt 0 ] && val=0
    if [ "$val" -ge 1048576 ]; then
        echo "$((val / 1048576)).$(((val % 1048576) * 10 / 1048576))MB/s"
    elif [ "$val" -ge 1024 ]; then
        echo "$((val / 1024)).$(((val % 1024) * 10 / 1024))KB/s"
    else
        echo "${val}B/s"
    fi
}

down=$(fmt "$rx_rate")
up=$(fmt "$tx_rate")

echo "{\"text\":\" $down  $up\"}"
